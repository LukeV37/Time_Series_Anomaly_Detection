#!/bin/bash -l
#PBS -N spt-train
#PBS -A AIDQ
#PBS -q gpu
#PBS -l select=1:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

PREPROCESS_CONFIG_PATH="${PREPROCESS_CONFIG_PATH:-src/preprocessing/configs/spt_pipeline_no_trim.yaml}"
TRAIN_CONFIG_PATH="${TRAIN_CONFIG_PATH:-src/training/configs/spt_tranad_no_trim.yaml}"

log "Working directory: $PBS_O_WORKDIR"
log "Running on host: $(hostname)"
log "Preprocessing config: $PREPROCESS_CONFIG_PATH"
log "Training config: $TRAIN_CONFIG_PATH"

nvidia-smi

log "Setting up environment"
source setup.sh

log "Starting preprocessing"
python scripts/spt/run_preprocessing.py --config "$PREPROCESS_CONFIG_PATH" --mode both
log "Finished preprocessing"

log "Starting training and test inference"
python scripts/spt/train_tranad.py --config "$TRAIN_CONFIG_PATH"
log "Finished training and test inference"

log "Starting histogram plotting"
if python scripts/spt/plot_spt_histogram.py --config "$TRAIN_CONFIG_PATH"
then
  log "Finished histogram plotting"
else
  log "Histogram plotting skipped due to incompatible plotting inputs"
fi

log "Workflow completed successfully"
