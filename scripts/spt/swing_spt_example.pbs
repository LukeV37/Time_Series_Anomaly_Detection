#!/bin/bash -l
#PBS -N spt-train
#PBS -A AIDQ
#PBS -q gpu
#PBS -l select=1:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

CONFIG_PATH="${CONFIG_PATH:-src/training/configs/spt_tranad.yaml}"
OUTPUT_DIR="/lcrc/project/AIDQ/users/lvaughan/run/spt/default"
TRAIN_PROCESSED_NPZ="$OUTPUT_DIR/train_processed.npz"
TEST_PROCESSED_NPZ="$OUTPUT_DIR/test_processed.npz"
TEST_ERRORS_NPY="$OUTPUT_DIR/test_errors.npy"
HISTOGRAM_1D_PNG="$OUTPUT_DIR/test_error_histogram_1d.png"
HISTOGRAM_2D_PNG="$OUTPUT_DIR/test_error_snr_histogram_2d.png"

log "Working directory: $PBS_O_WORKDIR"
log "Running on host: $(hostname)"
log "Training config: $CONFIG_PATH"
log "Output directory: $OUTPUT_DIR"

nvidia-smi

log "Setting up environment"
source setup.sh

log "Starting preprocessing"
python scripts/spt/run_preprocessing.py --mode both
log "Finished preprocessing"

log "Starting training and test inference"
python scripts/spt/train_tranad.py --config "$CONFIG_PATH"
log "Finished training and test inference"

log "Starting histogram plotting"
if python scripts/spt/plot_spt_histogram.py \
  --errors "$TEST_ERRORS_NPY" \
  --data-npz "$TEST_PROCESSED_NPZ" \
  --output-1d "$HISTOGRAM_1D_PNG" \
  --output-2d "$HISTOGRAM_2D_PNG"
then
  log "Finished histogram plotting"
else
  log "Histogram plotting skipped due to incompatible plotting inputs"
fi

log "Workflow completed successfully"
log "Train preprocessing artifact: $TRAIN_PROCESSED_NPZ"
log "Test preprocessing artifact: $TEST_PROCESSED_NPZ"
log "Test errors artifact: $TEST_ERRORS_NPY"
log "1D histogram artifact: $HISTOGRAM_1D_PNG"
log "2D histogram artifact: $HISTOGRAM_2D_PNG"
